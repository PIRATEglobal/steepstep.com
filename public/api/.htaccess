# All-Inkl's shared Apache setup uses access_compat syntax for file blocking.
# Keep this file within the host's allowed Limit override class.
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
<FilesMatch "^(form-abuse|form-secret)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>
