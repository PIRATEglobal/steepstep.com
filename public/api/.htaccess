Options -Indexes
# All-Inkl's shared Apache setup uses access_compat syntax for file blocking.
# The newer Apache authorization directive returns a server error when matched.
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
<FilesMatch "^(form-abuse|form-secret)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>
