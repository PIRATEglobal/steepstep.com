---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout title="Sicherheit und Datenschutz">
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href="/" aria-label="steepstep.com, Startseite"><img src="/brand/steepstep-mark.svg" alt="" width="32" height="32" /><span>steepstep</span><small>.com</small></a>
      <a class="button button--light" href="/">Zur Startseite</a>
    </div>
  </header>
  <main id="inhalt" class="wrap">
    <section class="final-cta">
      <p class="section-meta">Sicherheit / Vorschau</p>
      <h1 class="section-heading">Sicherheit und Datenschutz werden vor dem Start erklärt.</h1>
      <p class="hero-copy">Diese Seite wird vor dem Start mit dem sicheren Videodienst, den Auftragsbearbeitern, Speicherfristen, Auskunfts- und Löschwegen sowie dem Notfall- und Überweisungsweg ergänzt. In dieser Vorschau werden keine Gesundheitsdaten gespeichert.</p>
      <p class="pending">Diese Angaben sind in der privaten Vorschau noch nicht vollständig.</p>
      <a class="button" href="/">Zurück zur Startseite</a>
    </section>
  </main>
</BaseLayout>
