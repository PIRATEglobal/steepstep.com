---
import ConditionPage from '../../components/ConditionPage.astro';
const phases=[{name:'Einordnen',focus:'Mechanismus und Ort verstehen',marker:'Sprint, Antritt, Ausfallschritt oder Dehnung? Wir klären, was passiert ist und wie viel Alltag gerade möglich ist.'},{name:'Belasten',focus:'Kraft ohne Eile zurückholen',marker:'Brücke, Hüftstreckung und kontrollierte Beinarbeit wachsen von leicht zu anspruchsvoll, angepasst an Schmerz und Sicherheit.'},{name:'Laufen',focus:'Geschwindigkeit stufen',marker:'Gehen, lockeres Laufen, Beschleunigen und hohe Geschwindigkeit sind eigene Belastungen. Jede Stufe braucht Kapazität.'},{name:'Spielen',focus:'Sportanforderungen prüfen',marker:'Richtungswechsel, Kontakt und Ermüdung werden sportnah geübt. Mentales Vertrauen gehört zur Rückkehr dazu.'}];
---
<ConditionPage phases={phases} title="Oberschenkel gezerrt" description="Oberschenkel gezerrt oder beim Sprint eingeschossen: Aufbau und Rückkehr zu Lauf- und Teamsport." eyebrow="Beschwerden · Oberschenkel" intro="Ein stechender Schmerz beim Sprint kann den ganzen Bewegungsablauf verändern. Wir reduzieren zunächst die riskante Belastung und führen Sie dann kontrolliert zu Laufen, Tempo und Sport zurück." answer="Bei einer Muskelverletzung zählt die individuelle Kombination aus Ort, Mechanismus, Kraft, Geschwindigkeit und Sportanforderung. Es gibt keinen seriösen Einheitsplan und keinen sicheren Kalender für alle." onlineFit={['Die Beschwerden begannen bei einer klaren Bewegung und sind im Alltag überschaubar.','Sie möchten Lauf- oder Teamsport wieder aufnehmen.','Die Kraft nimmt nicht rasch ab und es gibt keine grosse, zunehmende Einblutung.']} inPerson={['Starke Blutergüsse, tastbare Delle oder deutliche Fehlstellung.','Sie können kaum gehen oder den Muskel nicht sinnvoll anspannen.','Schmerz am Sitzbein, wiederkehrende Verletzungen oder kein Fortschritt.']} approach="Bei Sprint- und Pivot-Sportarten entstehen Hamstringverletzungen häufig bei hoher Geschwindigkeit. Deshalb fragen wir nach Antritt, Tempo, Müdigkeit, vorherigen Beschwerden und der konkreten Sportrolle. Eine leichte Zerrung ist nicht dasselbe wie ein grösserer Riss oder eine Verletzung am Ursprung des Muskels." video="Wir beobachten zuerst Gehen und einfache, kontrollierte Hüft- und Beinbewegungen. Später können Brücke, Hüftknick, Lauftechnik und eingesandte Trainingssequenzen helfen. Ein maximaler Sprinttest gehört nicht in das erste Video. Bei grossem Kraftverlust, Verdacht auf kompletten Riss oder knöchernem Ausriss braucht es eine Untersuchung und gegebenenfalls Bildgebung." safety={['Pop mit grosser Schwäche, tastbarer Delle oder rasch zunehmendem Bluterguss','Fehlende Gehfähigkeit oder starke Schmerzen bei jeder Anspannung','Fokaler Schmerz am Sitzbein oder Verdacht auf Ausriss','Wiederkehrende Verletzung oder fehlender Fortschritt trotz Anpassung']} mistakes={['Sobald der Schmerz weniger wird, direkt maximal sprinten','Nur dehnen und Kraftarbeit auslassen','Eine pauschale Rückkehrfrist versprechen','Die Geschwindigkeit des eigenen Sports nicht testen']} stance="Wir messen Fortschritt daran, ob Sie die Anforderungen Ihres Sports wiederholt und mit Vertrauen bewältigen. Der Körper bekommt dabei die Zeit, die er für Kapazität braucht. Das ist langsamer als ein Versprechen und verlässlicher als eines." faqs={[{q:'Wie lange dauert eine Oberschenkelzerrung?',a:'Das reicht von Tagen bis zu mehreren Monaten, je nach Schwere, Ort, Funktion und Sportanforderung. Die internationale Konsensusarbeit empfiehlt eine individuelle Progression statt eines festen Rückkehrdatums.'},{q:'Wann darf ich wieder sprinten?',a:'Sprinten kommt nach kontrollierter Kraft und lockerem Laufen. Wir steigern Geschwindigkeit und Ermüdung in Stufen und prüfen, wie der Oberschenkel am nächsten Tag reagiert.'},{q:'Kann ich die Verletzung online abklären?',a:'Eine Verlaufskontrolle und Trainingssteuerung kann online gut passen. Eine grössere Verletzung oder ein unklarer Befund muss lokal untersucht werden.'}]} sources={[{label:'London International Consensus, Hamstring injury rehabilitation',url:'https://pubmed.ncbi.nlm.nih.gov/36650032/',date:'2023'},{label:'APTA, Telehealth Physical Therapy CPG',url:'https://www.apta.org/patient-care/evidence-based-practice-resources/cpgs/telerehabilitation-pt-practice-apta-cpg',date:'2024'}]} related={[{label:'Laufen',href:'/sport/laufen'},{label:'Sport & Bewegung',href:'/sport'},{label:'Kontakt',href:'/kontakt'}]} />
