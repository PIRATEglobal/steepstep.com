---
import ConditionPage from '../../components/ConditionPage.astro';
const phases=[{name:'Verstehen',focus:'Sehnenreaktion lesen',marker:'Wir ordnen Laufumfang, Höhenmeter, Sprünge, Schuhe und Morgensteifigkeit ein. Ziel ist eine belastbare Ausgangslage.'},{name:'Kraft',focus:'Wade gezielt aufbauen',marker:'Wadenheben und Varianten werden so dosiert, dass die Sehne arbeiten kann und die Reaktion am Folgetag beobachtbar bleibt.'},{name:'Tempo',focus:'Federung zurückgewinnen',marker:'Laufen, Steigungen und kleine Sprünge werden abgestuft ergänzt, wenn Kraft und Alltag das tragen.'},{name:'Ausdauer',focus:'Sport wiederholen können',marker:'Die relevante Frage lautet: Können Sie Ihre typische Woche wiederholen, mit einer Reaktion, die Sie steuern können?' }];
---
<ConditionPage phases={phases} title="Achillessehne und Laufbelastung" description="Achillessehnenschmerzen online einordnen: Belastungssteuerung, Wadenkraft und Rückkehr zum Sport." eyebrow="Beschwerden · Achillessehne" intro="Achillessehnenbeschwerden können entstehen, wenn sich Belastung und aktuelle Kapazität nicht gut treffen. Je nachdem, wo die Beschwerden liegen und wie reizbar die Sehne ist, sieht der Aufbau anders aus. Wir machen sichtbar, was sich verändert hat, und bauen die Belastbarkeit über Zeit wieder auf." answer="Bei geeigneten Achillessehnenbeschwerden ist progressives Waden- und Beintraining mit passender Belastungssteuerung oft ein wichtiger Teil der Behandlung. Die Auswahl von Übung, Bewegungsumfang und Dosis hängt von Ort, Verlauf und Reizbarkeit ab. Eine Sehne braucht dabei oft Monate. Schnelle Versprechen helfen niemandem." onlineFit={['Die Beschwerden hängen mit Laufen, Hügeln, Springen oder einem Trainingssprung zusammen.','Sie möchten Ihre Belastung klüger dosieren, statt komplett aufzuhören.','Es gibt keinen plötzlichen Knall und keinen vollständigen Verlust des Abstossens.']} inPerson={['Plötzlicher Knall, deutlicher Kraftverlust beim Abstoss oder eine tastbare Lücke.','Sie können kaum gehen oder der Fuss ist stark geschwollen.','Rötung, Überwärmung, Fieber oder ungeklärte Wadenschwellung.']} approach="Schmerz und Morgensteifigkeit an der Sehne sind wichtige Informationen, aber noch keine Diagnose. Wir unterscheiden im Gespräch Lage und Verlauf, fragen nach Lauf- und Sprungbelastung und prüfen, was die Sehne am selben und am nächsten Tag toleriert. Eine Symptomreaktion allein beweist keinen Gewebeschaden. Intensität, Dauer, Funktion und die Reaktion am Folgetag helfen, die nächste Dosis einzuordnen." video="Wir beobachten Gang, beid- und einbeiniges Wadenheben sowie, später und nur wenn passend, kontrolliertes Federn. Wir coachen die Übungstechnik, planen Pausen und sprechen über Steigungen und Tempo. Eine akute Ruptur oder eine andere Ursache im Fuss- und Unterschenkelbereich braucht eine Untersuchung vor Ort." safety={['Knall oder Schnappen mit sofortiger Schwäche beim Abstossen','Tastbare Lücke, starke Blutergüsse oder fehlende Gehfähigkeit','Deutliche Rötung, Überwärmung, Fieber oder ungeklärte Wadenschwellung','Beschwerden, die trotz angepasster Belastung fortschreiten']} mistakes={['Alle Aktivität auf null setzen','Schuhe als alleinige Lösung behandeln','Jeden Schmerz als Gewebeschaden lesen','Nach zwei guten Tagen direkt in Tempo und Hügel springen']} stance="Wir verfolgen nicht das Gefühl einer vollkommen stillen Sehne. Wir bauen die Fähigkeit auf, die Sie für Ihr Leben und Ihren Sport brauchen. Die Dosis darf klein beginnen und trotzdem ernst genommen werden." faqs={[{q:'Wie lange kann eine Achillessehne brauchen?',a:'Bei Achillessehnenbeschwerden planen wir häufig mit einem Aufbau über mehrere Monate. Ein Zeitraum von sechs bis neun Monaten kann vorkommen, sagt aber nichts Sicheres über Ihren persönlichen Verlauf. Alltag, Morgensteifigkeit, Wadenkraft, Laufen, Hügel und Sprünge sind unterschiedliche Stufen. Entscheidend sind Trend und Kapazität, nicht eine einzelne gute Einheit. Bei Knall, Verlust des Abstosses oder tastbarer Lücke braucht es sofort eine lokale Abklärung.'},{q:'Muss ich mit dem Laufen aufhören?',a:'Nicht zwingend. Wir stellen Belastungssteuerung und einen graduellen Aufbau in den Mittelpunkt. Je nach Reizbarkeit kann es sinnvoll sein, zuerst Tempo, Hügel, Umfang oder Sprünge zu reduzieren und verträgliche Bewegung und Wadenarbeit beizubehalten. Wir beobachten die Reaktion am selben und nächsten Tag. Ein Knall, deutliche Schwäche, starke Schwellung oder rasche Verschlechterung ist keine Situation für eine Online-Laufempfehlung.'},{q:'Sind Wadenheben immer richtig?',a:'Wadenkraft ist häufig ein wichtiger Teil des Aufbaus, aber nicht jede Variante passt zu jedem Ort, jeder Reizbarkeit und jeder Phase. Midportion- und ansatznahe Beschwerden können unterschiedliche Bewegungsumfänge und Progressionen verlangen. Wir wählen Variante, Last, Tempo und Umfang nach Ausgangskraft und Reaktion und steigern sie nachvollziehbar. Bei akuter Ruptur, starker Schwellung, Rötung/Überwärmung oder ungeklärter Wadenschwellung zuerst lokal abklären.'}]} sources={[{label:'APTA, Midportion Achilles Tendinopathy CPG revision',url:'https://www.apta.org/patient-care/evidence-based-practice-resources/cpgs/achilles-pain-stiffness-and-muscle-power-deficits-midportion-achilles-tendinopathy-revision-2024-cpg',date:'2024'},{label:'van der Vlist et al., Dutch multidisciplinary guideline',url:'https://pmc.ncbi.nlm.nih.gov/articles/PMC8479731/',date:'2021'},{label:'Royal National Orthopaedic Hospital, Achilles tendinopathy',url:'https://www.rnoh.nhs.uk/patients-and-visitors/patient-information-guides/achilles-tendinopathy',date:'abgerufen 2026'}]} related={[{label:'Laufen',href:'/sport/laufen'},{label:'Beschwerden',href:'/beschwerden/'},{label:'Preise',href:'/preise'}]} />
