---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferSummary from '../components/OfferSummary.astro';
import { offerPrices, offerPerSession } from '../data/offers';
import '../styles/global.css';
import '../styles/motion.css';
const heroImage = '/images/optimized/hero-1400.webp';
const proofImage = '/images/optimized/proof-1000.webp';
---
<BaseLayout>
  <main id="inhalt">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Online-Physiotherapie in der Schweiz</p>
          <h1 id="hero-title">Wieder dorthin, wo Sie hinwollen.</h1>
          <p class="hero-copy">Schmerzen oder eine Verletzung halten Sie vom Sport ab? In einem kostenlosen 20-minütigen Orientierungsgespräch besprechen Sie Ihr Anliegen mit einer qualifizierten Fachperson. Danach wissen Sie, welcher nächste Schritt für Sie passt.</p>
          <div class="hero-actions"><a class="button" href="/kontakt">Kostenloses Gespräch anfragen</a><a class="button button--light" href="#ablauf">So läuft es ab</a></div>
          <p class="meta-line">20 Minuten kostenlos · unverbindlich · per Video</p>
          <p class="hero-proof"><strong>Qualifizierte Fachpersonen für Sport und Bewegung.</strong><br />Mit klarer Empfehlung und einem Plan, der in Ihren Alltag passt.</p>
        </div>
        <div class="hero-visual"><figure><div class="portrait-frame"><img src={heroImage} width="1400" height="933" alt="Person in Sportkleidung beim Aufwärmen unter einer Brücke" fetchpriority="high" /></div><figcaption class="image-caption">Eine kontrollierte Bewegung als Anfang.</figcaption></figure></div>
      </div>
    </section>
    <section class="section" id="ablauf" aria-labelledby="ablauf-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Ablauf</p><h2 class="section-heading" id="ablauf-title">Sie wissen, was Sie wieder tun möchten. Wir klären den nächsten Schritt.</h2></div><div class="path">
      <article class="path-step"><h3>Starten Sie mit Orientierung.</h3><p>20 Minuten kostenlos und unverbindlich. Wir klären Ihr Anliegen und ob ein nächster Termin sinnvoll ist. Es ist keine Untersuchung oder Diagnose.</p></article>
      <article class="path-step"><h3>Besprechen Sie Ihre Situation.</h3><p>Wenn es passt, folgt der 60-minütige Online-Ersttermin für {offerPrices.assessment} mit einer qualifizierten Fachperson. Wir beobachten geeignete Bewegungen und sprechen über das, was Sie belastet.</p></article>
      <article class="path-step"><h3>Sie erhalten eine Empfehlung.</h3><p>Schriftlich, verständlich, mit dem nächsten Schritt. Auch wenn eine Untersuchung vor Ort sinnvoller ist.</p></article>
      <article class="path-step"><h3>Bleiben Sie in Bewegung.</h3><p>Eine längere Begleitung nur, wenn sie fachlich passt und zu Ihrem Alltag passt.</p></article>
    </div></div></div></section>
    <section class="section consultation-section" aria-labelledby="termin-title"><div class="wrap"><div class="consultation-grid"><div><p class="section-meta">Der erste Termin</p><h2 class="section-heading" id="termin-title">Was Sie im Online-Ersttermin klären.</h2><p class="lead-copy">Sie erzählen, was passiert ist, was Sie wieder tun möchten und was Sie bisher versucht haben. Wir sprechen über Belastung, Alltag und Bewegungen, die sich für Ihre Situation sinnvoll beobachten lassen. Am Ende wissen Sie, was Sie als Nächstes tun können und ob eine Betreuung per Video für Sie passt.</p></div><div class="clarity-list"><div><h3>Ihre Geschichte</h3><p>Beschwerden, Verlauf, Ziel und die Schritte, die Sie bereits probiert haben.</p></div><div><h3>Ihre Bewegung</h3><p>Nur Bewegungen, die sich im Gespräch sicher und sinnvoll beobachten lassen.</p></div><div><h3>Ihre Entscheidung</h3><p>Was Sie jetzt ausprobieren können und worauf Sie im Alltag achten sollen.</p></div><div><h3>Ihr nächster Ort</h3><p>Online weiter, vor Ort abklären oder zuerst ärztlich beurteilen lassen.</p></div></div></div></div></section>
    <section class="section method-section" aria-labelledby="methode-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Unsere Methode</p><h2 class="section-heading" id="methode-title">Nicht mehr Übungen. Die richtige Entscheidung für Ihren nächsten Schritt.</h2></div><div><p class="lead-copy">Wir arbeiten in kurzen Schleifen: verstehen, ausprobieren, beobachten, anpassen. Das macht die Betreuung greifbar und gibt Ihnen zwischen den Terminen etwas Konkretes in die Hand.</p><div class="method-grid"><article><span>Verstehen</span><p>Was möchten Sie wieder tun? Welche Belastung fehlt Ihnen gerade?</p></article><article><span>Ausprobieren</span><p>Sie testen eine vereinbarte Bewegung in einer Dosierung, die zu Ihrem Alltag passt.</p></article><article><span>Beobachten</span><p>Sie achten auf die Reaktion Ihres Körpers und bringen Ihre Beobachtung ins nächste Gespräch.</p></article><article><span>Anpassen</span><p>Wir entscheiden gemeinsam, was bleiben darf, was sich verändert und wann eine Abklärung vor Ort sinnvoll ist.</p></article></div></div></div></div></section>
    <section class="section specimen-section" aria-labelledby="empfehlung-title"><div class="wrap specimen-grid"><div class="specimen-sheet"><p class="specimen-kicker">Fiktives Beispiel, keine Patientendaten</p><h3>Ihre schriftliche Empfehlung</h3><dl><div><dt>Ihr Ziel</dt><dd>wieder zwei ruhige Läufe pro Woche aufnehmen</dd></div><div><dt>Ausgangslage</dt><dd>20 bis 25 Minuten sind möglich. Am nächsten Morgen reagiert das Knie deutlich stärker.</dd></div><div><dt>Für die nächsten sieben Tage</dt><dd>Drei kurze Einheiten mit Gehpausen. Tempo, Strecke und Untergrund bleiben gleich.</dd></div><div><dt>Beobachten Sie</dt><dd>Die Reaktion während des Laufs, am Abend und am nächsten Morgen. Auch Treppen und Alltag zählen.</dd></div><div><dt>Nächster Check</dt><dd>Nach drei Einheiten entscheiden wir, ob zuerst die Dauer oder die Pause verändert wird.</dd></div><div><dt>Vor Ort abklären</dt><dd>Bei deutlicher Schwellung, Wegknicken, Unfall, rascher Verschlechterung oder neuen neurologischen Zeichen.</dd></div></dl></div><div><p class="section-meta">Was bleibt</p><h2 class="section-heading" id="empfehlung-title">Sie wissen, was Sie als Nächstes tun können.</h2><p class="lead-copy">Nach dem kostenlosen Orientierungsgespräch entscheiden Sie in Ruhe, ob ein bezahlter Ersttermin sinnvoll ist. Nach dem Termin halten wir den nächsten Schritt schriftlich fest. Das Beispiel zeigt, wie eine Empfehlung aussehen kann: Ziel, Ausgangslage, eine überschaubare Belastung, Beobachtung und ein klarer Checkpoint. Ihre persönliche Empfehlung richtet sich nach dem Gespräch und Ihrem Ziel.</p></div></div></section>
    <section class="section dark-section" id="angebot" aria-labelledby="angebot-title"><div class="wrap"><div class="offer-intro"><p class="section-meta">Das Angebot</p><h2 class="section-heading" id="angebot-title">Sie wählen die Begleitung, die zu Ihrem nächsten Schritt passt.</h2><p class="muted">Alle Preise in Schweizer Franken. Privat zu bezahlen. Ob Ihre Zusatzversicherung einen Beitrag übernimmt, klären Sie bitte vor dem Kauf direkt mit Ihrer Versicherung.</p></div><OfferSummary variant="compact" /></div></section>
    <section class="section continuation-section" aria-labelledby="zwischen-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Zwischen den Terminen</p><h2 class="section-heading" id="zwischen-title">Was zwischen den Terminen weitergeht.</h2></div><div><p class="lead-copy">Sie probieren die vereinbarten Schritte in Ihrem Alltag aus. Bei einer aktiven Begleitung können Sie Rückfragen oder neue Beobachtungen über den vorab vereinbarten, geschützten Kommunikationsweg zwischen den Terminen teilen. Dieser Weg ist für bestehende Kundinnen und Kunden gedacht, nicht für öffentliche Anfragen. Ihre Fachperson passt den Plan im nächsten Termin an und sagt Ihnen, wenn eine andere Abklärung sinnvoll ist.</p><div class="service-details"><div><span>Im Paket enthalten</span><p>Vier oder sechs Videotermine à 45 Minuten, ein abgestimmter Bewegungsplan und die gemeinsame Anpassung Ihrer Belastung.</p></div><div><span>So beginnt es</span><p>Sie starten mit dem 60-minütigen Ersttermin. Eine Begleitung empfehlen wir erst danach, wenn sie fachlich passt. Ihre Anfrage und die Kontaktaufnahme sind unverbindlich.</p></div></div></div></div></div></section>
    <section class="section" aria-labelledby="fachpersonen-title"><div class="wrap proof-grid"><div><div class="proof-image"><img src={proofImage} width="1000" height="630" loading="lazy" alt="Person bei einer Bewegungsübung am Wasser bei Sonnenuntergang" /></div><p class="image-caption">Ein Bild für den Moment zwischen Anstrengung und nächstem Schritt.</p></div><div class="proof-copy"><p class="section-meta">Das Team</p><h2 id="fachpersonen-title">Erfahrung, die Bewegung ernst nimmt.</h2><p>Hinter steepstep steht eine Gruppe qualifizierter Fachpersonen mit jahrzehntelanger Erfahrung in Physiotherapie, Sport und der Begleitung aktiver Menschen.</p><p>Eine davon ist Natalja Krol. Als Physiotherapeutin mit Schwerpunkt Sportphysiotherapie kennt sie den Anspruch, wieder in Training, Wettkampf und Alltag zurückzufinden. Sie bringt Erfahrung aus dem Leistungssport mit, unter anderem mit Basketball- und Fussballspielern.</p><a class="text-link" href="/ueber-uns">Das Team kennenlernen <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="section soft-section" aria-labelledby="sport-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Sport &amp; Bewegung</p><h2 class="section-heading" id="sport-title">Ihr Sport gibt die Richtung vor.</h2></div><div><p class="lead-copy">Laufen oder Skifahren. Wir sprechen über die Belastung, die Sie zurückgewinnen möchten, und übersetzen sie in einen nächsten machbaren Schritt.</p><div class="sport-links"><a href="/sport/laufen"><span>Laufen</span><small>Belastung und Rhythmus</small></a><a href="/sport/skifahren"><span>Skifahren</span><small>Vorbereitung auf die Piste</small></a></div></div></div></div></section>
    <section class="section story-section" aria-labelledby="story-title"><div class="wrap story-grid"><div><p class="section-meta">Warum steepstep</p><h2 class="section-heading" id="story-title">Jeder Fortschritt beginnt mit einem Schritt, der wirklich zu Ihnen passt.</h2></div><div><p class="lead-copy">Der Name erinnert daran, dass Veränderung selten in einem Sprung passiert. Ein steiler Weg braucht Aufmerksamkeit, gute Begleitung und den Mut, das Tempo an den eigenen Körper anzupassen.</p><p class="lead-copy">steepstep steht für diesen Weg. Für Physiotherapie, die Ihnen zuhört, klar einordnet und Sie dort abholt, wo Sie gerade stehen.</p></div></div></section>
    <section class="section prep-section" aria-labelledby="vorbereiten-title"><div class="wrap prep-grid"><div><p class="section-meta">Vorbereiten</p><h2 class="section-heading" id="vorbereiten-title">So bereiten Sie den Termin vor.</h2><p class="lead-copy">Für den Termin brauchen Sie keinen besonderen Aufbau. Ein paar einfache Vorbereitungen helfen, damit wir Ihre Situation in Ruhe besprechen können.</p></div><div class="prep-list"><div><h3>Ein ruhiger Ort</h3><p>Wählen Sie einen Raum, in dem Sie ungestört sprechen und sich kurz bewegen können.</p></div><div><h3>Kamera und Mikrofon</h3><p>Nutzen Sie ein Gerät mit stabiler Verbindung. Prüfen Sie Bild und Ton vor dem Termin.</p></div><div><h3>Bequeme Kleidung</h3><p>Tragen Sie Kleidung, in der Sie sich frei bewegen können. Hilfsmittel oder Schuhe, die für Ihr Ziel wichtig sind, dürfen bereitliegen.</p></div><div><h3>Ihr Standort</h3><p>Teilen Sie uns mit, wo Sie sich beim Termin befinden. Das ist für die fachliche und organisatorische Einordnung wichtig.</p></div></div></div></section>
    <section class="section dark-section" aria-labelledby="sicherheit-title"><div class="wrap"><p class="section-meta">Sicherheit</p><h2 class="section-heading" id="sicherheit-title">Online-Betreuung hat klare Grenzen.</h2><div class="decision-route" aria-label="Entscheidungsweg für die Eignung"><p>Sie schildern Ihre Situation</p><span aria-hidden="true">→</span><p>Die Fachperson prüft, ob Video genügt</p><span aria-hidden="true">→</span><p>Online weiter, Plan anpassen oder vor Ort abklären</p></div><div class="safety-grid"><div class="safety-cell"><h3>Wenn vor Ort besser ist</h3><p>Eine Betreuung per Video passt nicht zu jeder Situation. Wenn eine Untersuchung oder Behandlung vor Ort nötig ist, sagen wir Ihnen das und empfehlen den nächsten Schritt. Bei Unsicherheit wenden Sie sich an eine lokale medizinische Fachstelle.</p></div><div class="safety-cell"><h3>Wenn es um Ihre Daten geht</h3><p>Termine werden standardmässig nicht aufgezeichnet. Die grundlegenden Angaben finden Sie auf unserer Seite zu Sicherheit und Datenschutz. <a href="/sicherheit-und-datenschutz">Sicherheit und Datenschutz</a>.</p></div></div></div></section>
    <section class="section" id="fragen" aria-labelledby="fragen-title"><div class="wrap"><p class="section-meta">Fragen</p><h2 class="section-heading" id="fragen-title">Was Sie vor dem ersten Termin wissen möchten.</h2><div class="faq-list"><details><summary>Ist Online-Physiotherapie für mich geeignet?</summary><p>Das klären wir im kostenlosen Gespräch und, wenn passend, im Ersttermin. Video kann für Belastungssteuerung, Übungscoaching und die Rückkehr zu Alltag oder Sport sinnvoll sein, wenn Verlauf, Ziel und sichere Bewegungen verständlich besprochen werden können. Eine Kamera ersetzt keine körperliche Untersuchung, Palpation, Bildgebung oder Notfallversorgung. Bei deutlicher Schwellung, frischem schwerem Unfall, neurologischen Zeichen, Fieber oder Unsicherheit empfehlen wir eine lokale Abklärung. <a href="/fragen/#eignung">Mehr zur Eignung</a>.</p></details><details><summary>Was soll ich vor dem Termin vorbereiten?</summary><p>Ein ruhiger Raum, stabile Verbindung, Kamera und Mikrofon genügen. Tragen Sie Kleidung, in der Sie wichtige Bewegungen sicher zeigen können. Überlegen Sie vorab, was Sie wieder tun möchten, wann die Beschwerden begonnen haben und welche Belastung sie verändert. Bitte senden Sie keine Gesundheitsdaten über das Kontaktformular oder ungeschützte E-Mail. <a href="/fragen/#vorbereitung">Vorbereitung ansehen</a>.</p></details><details><summary>Was erhalte ich nach dem Ersttermin?</summary><p>Sie erhalten Ihren nächsten Schritt schriftlich: Ziel, sinnvolle Belastung, passende Übungen oder eine Belastungsregel, Beobachtungskriterien und den nächsten Checkpoint. Wenn Video nicht ausreicht, sagen wir das offen und empfehlen die passende Abklärung vor Ort. <a href="/fragen/#eignung">So arbeiten wir</a>.</p></details><details><summary>Übernimmt meine Zusatzversicherung die Kosten?</summary><p>Das hängt von Ihrer Police ab. Fragen Sie vor dem Kauf schriftlich, ob die konkrete Online-Leistung von steepstep anerkannt wird und welche Unterlagen nötig sind. Eine Erstattung ist erst verlässlich, wenn Ihre Versicherung sie bestätigt hat.</p></details><details><summary>Wo muss ich mich beim Termin befinden?</summary><p>Sie müssen sich während des Termins in der Schweiz befinden. Ihren Standort bestätigen wir vor der Betreuung; Termine aus einem anderen Land bieten wir derzeit nicht an.</p></details><details><summary>Was passiert, wenn die Verbindung abbricht?</summary><p>Bei einer aktiven Begleitung melden wir uns über den vorab vereinbarten, geschützten Kommunikationsweg und klären die Fortsetzung. Dieser Weg ist für bestehende Kundinnen und Kunden zwischen den Terminen gedacht. Bitte buchen Sie keinen Ersatztermin und senden Sie keine Gesundheitsdaten per ungeschützter Nachricht, bevor Sie von uns hören.</p></details><details><summary>Werden Termine aufgezeichnet?</summary><p>Nein, standardmässig nicht. Bild und Ton werden nicht für eine spätere Aufzeichnung gespeichert. Jede Ausnahme müsste separat und ausdrücklich vereinbart werden. Die technischen Daten des Videodienstes sind in der <a href="/datenschutz">Datenschutzerklärung</a> beschrieben.</p></details><details><summary>Was gilt bei einer Absage?</summary><p>Bis 24 Stunden vor dem Termin können Sie kostenlos absagen oder verschieben. Danach kann höchstens der Preis des betroffenen Termins berechnet werden: {offerPrices.assessment} beim Ersttermin, {offerPerSession.fourSession} im Viererpaket oder {offerPerSession.sixSession} im Sechserpaket. Bei Krankheit, Notfall oder einem anderen wichtigen Grund fällt keine solche Belastung an. <a href="/agb">Vollständige Bedingungen</a>.</p></details></div></div></section>
    <section class="final-cta wrap"><div class="final-inner"><h2>Prüfen Sie, ob ein Online-Ersttermin für Sie passt.</h2><div><a class="button" href="/kontakt">Kostenloses Gespräch anfragen</a><p class="status-note">Wir melden uns persönlich mit den nächsten Schritten.</p></div></div></section>
  </main>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('.menu');
    const nav = document.querySelector<HTMLElement>('.nav');
    const closeMenu = () => {
      nav?.classList.remove('is-open');
      menu?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-label', 'Menü öffnen');
    };
    menu?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open') ?? false;
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? 'Menü schliessen' : 'Menü öffnen');
    });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
        closeMenu();
        menu?.focus();
      }
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canReveal = !reduce && 'IntersectionObserver' in window;
    if (canReveal) { document.documentElement.classList.add('js-ready');
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.section, .final-cta, .path-step').forEach((el) => observer.observe(el));
    } else document.querySelectorAll('.section, .final-cta, .path-step').forEach((el) => el.classList.add('is-visible'));
  </script>
</BaseLayout>
