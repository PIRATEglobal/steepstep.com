---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import '../styles/motion.css';
const heroImage = '/images/hero.jpg';
const proofImage = '/images/proof.jpg';
---
<BaseLayout>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="wordmark" href="/" aria-label="steepstep.com, Startseite"><img src="/brand/steepstep-mark.svg" alt="" width="32" height="32" /><span>steepstep</span><small>.com</small></a>
      <nav class="nav" id="hauptnavigation" aria-label="Hauptnavigation">
        <a href="#ablauf">Ablauf</a><a href="#angebot">Angebot</a><a href="#fragen">Fragen</a>
        <a class="button" href="/erstgespraech-buchen">Online-Ersttermin buchen</a>
      </nav>
      <button class="menu" type="button" aria-controls="hauptnavigation" aria-label="Menü öffnen" aria-expanded="false">Menü</button>
    </div>
  </header>
  <main id="inhalt">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-content">
          <p class="eyebrow">Online-Physiotherapie in der Schweiz</p>
          <h1 id="hero-title">Wieder dorthin, wo Sie hinwollen.</h1>
          <p class="hero-copy">Schmerzen oder eine Verletzung halten Sie vom Sport ab? Im Online-Ersttermin besprechen Sie Ihre Situation mit einer qualifizierten Fachperson. Danach wissen Sie, ob eine Betreuung per Video für Sie passt und was Sie als Nächstes tun können.</p>
          <div class="hero-actions"><a class="button" href="/erstgespraech-buchen">Online-Ersttermin buchen</a><a class="button button--light" href="#ablauf">So läuft es ab</a></div>
          <p class="meta-line">60 Minuten · Preis wird vor Veröffentlichung ergänzt · Videotermin</p>
          <p class="hero-proof"><strong>Fachpersonen mit Ausbildung und Berechtigung zur Berufsausübung.</strong><br />Namen und Nachweise werden vor dem Start ergänzt.</p>
        </div>
        <div class="hero-visual"><figure><div class="portrait-frame"><img src={heroImage} width="1400" height="933" alt="Person in Sportkleidung beim Aufwärmen unter einer Brücke" fetchpriority="high" /></div><figcaption class="image-caption">Illustrative Aufnahme. Eigene Bilder folgen.</figcaption></figure></div>
      </div>
    </section>
    <section class="section" id="ablauf" aria-labelledby="ablauf-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Ablauf</p><h2 class="section-heading" id="ablauf-title">Sie wissen, was Sie wieder tun möchten. Wir klären den nächsten Schritt.</h2></div><div class="path">
      <article class="path-step"><h3>Erzählen Sie, was passiert ist.</h3><p>Beschwerden, Ziel und Bewegung. Sie bringen Ihre Geschichte mit.</p></article>
      <article class="path-step"><h3>Besprechen Sie Ihre Situation.</h3><p>60 Minuten mit einer qualifizierten Fachperson. Wir beobachten geeignete Bewegungen und sprechen über das, was Sie belastet.</p></article>
      <article class="path-step"><h3>Sie erhalten eine Empfehlung.</h3><p>Schriftlich, verständlich, mit dem nächsten Schritt. Auch wenn eine Untersuchung vor Ort sinnvoller ist.</p></article>
      <article class="path-step"><h3>Bleiben Sie in Bewegung.</h3><p>Eine längere Begleitung nur, wenn sie fachlich passt und zu Ihrem Alltag passt.</p></article>
    </div></div></div></section>
    <section class="section consultation-section" aria-labelledby="termin-title"><div class="wrap"><div class="consultation-grid"><div><p class="section-meta">Der erste Termin</p><h2 class="section-heading" id="termin-title">Was Sie im Online-Ersttermin klären.</h2><p class="lead-copy">Sie erzählen, was passiert ist, was Sie wieder tun möchten und was Sie bisher versucht haben. Wir sprechen über Belastung, Alltag und Bewegungen, die sich für Ihre Situation sinnvoll beobachten lassen. Am Ende wissen Sie, was Sie als Nächstes tun können und ob eine Betreuung per Video für Sie passt.</p></div><div class="clarity-list"><div><h3>Ihre Geschichte</h3><p>Beschwerden, Verlauf, Ziel und die Schritte, die Sie bereits probiert haben.</p></div><div><h3>Ihre Bewegung</h3><p>Nur Bewegungen, die sich im Gespräch sicher und sinnvoll beobachten lassen.</p></div><div><h3>Ihre Entscheidung</h3><p>Was Sie jetzt ausprobieren können und worauf Sie im Alltag achten sollen.</p></div><div><h3>Ihr nächster Ort</h3><p>Online weiter, vor Ort abklären oder zuerst ärztlich beurteilen lassen.</p></div></div></div></div></section>
    <section class="section specimen-section" aria-labelledby="empfehlung-title"><div class="wrap specimen-grid"><div class="specimen-sheet"><p class="specimen-kicker">Fiktives Beispiel, keine Patientendaten</p><h3>Ihre schriftliche Empfehlung</h3><dl><div><dt>Ihr Ziel</dt><dd>wieder zwei lockere Läufe pro Woche aufnehmen</dd></div><div><dt>Für die nächsten Tage</dt><dd>die vereinbarte Bewegung in der besprochenen Dosierung testen</dd></div><div><dt>Achten Sie auf</dt><dd>die gemeinsam festgelegten Warnzeichen</dd></div><div><dt>Nächster Schritt</dt><dd>Termin mit derselben Fachperson oder Abklärung vor Ort</dd></div></dl></div><div><p class="section-meta">Was bleibt</p><h2 class="section-heading" id="empfehlung-title">Sie wissen, was Sie als Nächstes tun können.</h2><p class="lead-copy">Nach dem Termin halten wir den nächsten Schritt schriftlich fest. Die Darstellung hier ist ein fiktives Beispiel. Inhalt, Umfang und Form werden fachlich geprüft und vor dem Start verbindlich beschrieben.</p></div></div></section>
    <section class="section dark-section" id="angebot" aria-labelledby="angebot-title"><div class="wrap offer-grid"><div class="offer-copy"><p class="section-meta">Ihr erster Schritt</p><h2 class="section-heading" id="angebot-title">Ein Gespräch, dann wissen Sie mehr.</h2><p class="muted">Der Online-Ersttermin ist der Anfang. Erst danach entscheiden Sie gemeinsam, ob eine Begleitung per Video sinnvoll ist.</p></div><div class="offer-sheet"><h3>Online-Ersttermin</h3><p>60 Minuten per Video<br />Ihre Situation, Ihre Ziele, ein nächster Schritt.</p><ul class="offer-list"><li>Gespräch über Beschwerden und Belastung</li><li>Beobachtung geeigneter Bewegungen</li><li>Schriftliche Empfehlung danach</li><li>Klärung, ob Online-Betreuung passt</li></ul><div class="pending">Preis und Buchungsbedingungen werden vor Veröffentlichung bestätigt.</div><span class="button" aria-disabled="true">Buchung folgt</span><p class="status-note">Die Buchung ist in dieser Vorschau noch nicht aktiv.</p></div></div></section>
    <section class="section continuation-section" aria-labelledby="zwischen-title"><div class="wrap"><div class="intro-grid"><div><p class="section-meta">Zwischen den Terminen</p><h2 class="section-heading" id="zwischen-title">Was zwischen den Terminen weitergeht.</h2></div><div><p class="lead-copy">Sie probieren die vereinbarten Schritte in Ihrem Alltag aus. Wenn Rückfragen oder neue Beobachtungen auftauchen, teilen Sie sie über den freigegebenen Kanal. Ihre Fachperson passt den Plan im nächsten Termin an und sagt Ihnen, wenn eine andere Abklärung sinnvoll ist.</p><div class="service-details"><div><span>Vor dem Start festgelegt</span><p>Anzahl und Länge der Folgetermine, Antwortzeit, sichere Kommunikation und Dokumentation.</p></div><div><span>Noch offen</span><p>Der genaue Paketumfang, asynchrone Rückmeldungen und die geltenden Ausschlüsse werden vor dem Kauf klar ausgewiesen.</p></div></div></div></div></div></section>
    <section class="section" aria-labelledby="fachpersonen-title"><div class="wrap proof-grid"><div><div class="proof-image"><img src={proofImage} width="1000" height="630" loading="lazy" alt="Silhouette einer Person bei einer Bewegungsübung am Wasser bei Sonnenuntergang" /></div><p class="image-caption">Illustrative Aufnahme. Keine Fachperson und keine Patientin.</p></div><div class="proof-copy"><p class="section-meta">Fachpersonen</p><h2 id="fachpersonen-title">Bevor Sie buchen, lernen Sie die Fachpersonen kennen.</h2><p>Sie erfahren, welche Ausbildung und Erfahrung sie mitbringen. Die Namen, Titel, Schweizer Bewilligungen und sportlichen Schwerpunkte werden hier vor dem Start sichtbar belegt.</p><p class="proof-placeholder">Diese Angaben sind in der privaten Vorschau bewusst noch nicht ausgefüllt. So entsteht kein falsches Vertrauenssignal.</p></div></div></section>
    <section class="section prep-section" aria-labelledby="vorbereiten-title"><div class="wrap prep-grid"><div><p class="section-meta">Vorbereiten</p><h2 class="section-heading" id="vorbereiten-title">So bereiten Sie den Termin vor.</h2><p class="lead-copy">Für den Termin brauchen Sie keinen besonderen Aufbau. Ein paar einfache Vorbereitungen helfen, damit wir Ihre Situation in Ruhe besprechen können.</p></div><div class="prep-list"><div><h3>Ein ruhiger Ort</h3><p>Wählen Sie einen Raum, in dem Sie ungestört sprechen und sich kurz bewegen können.</p></div><div><h3>Kamera und Mikrofon</h3><p>Nutzen Sie ein Gerät mit stabiler Verbindung. Prüfen Sie Bild und Ton vor dem Termin.</p></div><div><h3>Bequeme Kleidung</h3><p>Tragen Sie Kleidung, in der Sie sich frei bewegen können. Hilfsmittel oder Schuhe, die für Ihr Ziel wichtig sind, dürfen bereitliegen.</p></div><div><h3>Ihr Standort</h3><p>Teilen Sie uns mit, wo Sie sich beim Termin befinden. Das ist für die fachliche und organisatorische Einordnung wichtig.</p></div></div></div></section>
    <section class="section dark-section" aria-labelledby="sicherheit-title"><div class="wrap"><p class="section-meta">Sicherheit</p><h2 class="section-heading" id="sicherheit-title">Online-Betreuung hat klare Grenzen.</h2><div class="decision-route" aria-label="Entscheidungsweg für die Eignung"><p>Sie schildern Ihre Situation</p><span aria-hidden="true">→</span><p>Die Fachperson prüft, ob Video genügt</p><span aria-hidden="true">→</span><p>Online weiter, Plan anpassen oder vor Ort abklären</p></div><div class="safety-grid"><div class="safety-cell"><h3>Wenn vor Ort besser ist</h3><p>Eine Betreuung per Video passt nicht zu jeder Situation. Wenn eine Untersuchung oder Behandlung vor Ort nötig ist, sagen wir Ihnen das und empfehlen den nächsten Schritt. Die genauen Warnzeichen und die passende Weiterleitung werden von der verantwortlichen Fachperson vor dem Start freigegeben.</p></div><div class="safety-cell"><h3>Wenn es um Ihre Daten geht</h3><p>Termine werden standardmässig nicht aufgezeichnet. Die Angaben zu Datenschutz und Sicherheit werden vor dem Start veröffentlicht. <a href="/sicherheit-und-datenschutz">Sicherheit und Datenschutz im Aufbau</a>.</p></div></div></div></section>
    <section class="section" id="fragen" aria-labelledby="fragen-title"><div class="wrap"><p class="section-meta">Fragen</p><h2 class="section-heading" id="fragen-title">Was Sie vor dem ersten Termin wissen möchten.</h2><div class="faq-list"><details><summary>Ist Online-Physiotherapie für mich geeignet?</summary><p>Das klären Sie im Online-Ersttermin. Eine Betreuung per Video kann passen, wenn Ihre Situation sicher beurteilt und begleitet werden kann. Wenn Sie eine Untersuchung oder Behandlung vor Ort brauchen, sagen wir Ihnen das.</p></details><details><summary>Was soll ich vor dem Termin vorbereiten?</summary><p>Ein ruhiger Raum, eine stabile Internetverbindung, Kamera und Mikrofon genügen. Tragen Sie bequeme Kleidung und halten Sie Hilfsmittel bereit, die für Ihr Ziel wichtig sind.</p></details><details><summary>Was erhalte ich nach dem Ersttermin?</summary><p>Sie erhalten den gemeinsam geklärten nächsten Schritt schriftlich. Das konkrete Format und der Umfang werden vor dem Start verbindlich beschrieben.</p></details><details><summary>Übernimmt meine Zusatzversicherung die Kosten?</summary><p>Das hängt von Ihrer Police und einer schriftlichen Bestätigung durch die Versicherung ab. Bitte klären Sie dies vor dem Kauf.</p></details><details><summary>Wo muss ich mich beim Termin befinden?</summary><p>Sie müssen sich beim Termin in der Schweiz befinden. Ihren Standort klären wir vor jeder Betreuung, damit der Rahmen fachlich und organisatorisch passt.</p></details><details><summary>Was passiert, wenn die Verbindung abbricht?</summary><p>Die Kontaktmöglichkeit für diesen Fall und das Vorgehen werden Ihnen vor dem Termin mitgeteilt. Bitte buchen Sie keinen Ersatztermin, bevor Sie von uns hören.</p></details><details><summary>Werden Termine aufgezeichnet?</summary><p>Nein, standardmässig nicht. Jede Ausnahme würde eine eigene, ausdrückliche Einwilligung erfordern.</p></details><details><summary>Was gilt bei einer Absage?</summary><p>Die finale Frist, Gebühren, Rückerstattung und Umbuchung werden vor dem Kauf deutlich angezeigt.</p></details></div></div></section>
    <section class="final-cta wrap"><div class="final-inner"><h2>Prüfen Sie, ob ein Online-Ersttermin für Sie passt.</h2><div><a class="button" href="/erstgespraech-buchen">Online-Ersttermin buchen</a><p class="status-note">Vorschau, noch keine aktive Buchung.</p></div></div></section>
  </main>
  <footer class="site-footer"><div class="wrap footer-inner"><div class="footer-brand"><a class="wordmark wordmark--reverse" href="/" aria-label="steepstep.com, Startseite"><img src="/brand/steepstep-mark-reverse.svg" alt="" width="32" height="32" /><span>steepstep</span><small>.com</small></a><br /><span>Online-Physiotherapie für Sport und Bewegung</span></div><div class="footer-links"><a href="/sicherheit-und-datenschutz">Sicherheit &amp; Privatsphäre</a><a href="/fragen">Fragen</a><a href="/erstgespraech-buchen">Erstgespräch</a></div></div></footer>
  <script>
    const menu = document.querySelector<HTMLButtonElement>('.menu');
    const nav = document.querySelector<HTMLElement>('.nav');
    const closeMenu = () => {
      nav?.classList.remove('is-open');
      menu?.setAttribute('aria-expanded', 'false');
      menu?.setAttribute('aria-label', 'Menü öffnen');
    };
    menu?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open') ?? false;
      menu.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-label', open ? 'Menü schliessen' : 'Menü öffnen');
    });
    nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
        closeMenu();
        menu?.focus();
      }
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.section, .final-cta, .path-step').forEach((el) => observer.observe(el));
    } else document.querySelectorAll('.section, .final-cta, .path-step').forEach((el) => el.classList.add('is-visible'));
  </script>
</BaseLayout>
